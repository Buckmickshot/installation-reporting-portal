# Supabase project (Settings → API). For the local stack, `npm run db:start` prints these.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Geoscape (PSMA) key for verified address lookup. Without it, addresses are typed manually.
REACT_APP_GEOSCAPE_API_KEY=
